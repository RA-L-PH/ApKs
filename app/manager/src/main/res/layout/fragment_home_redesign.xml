<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Unified Top Row: Mode Tabs on Left + Status Pill at the End -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Modern Segmented Mode Selector Button Group -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeToggleGroup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@+id/tabWireless">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabWireless"
                style="@style/SegmentedPillButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Wireless" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabRoot"
                style="@style/SegmentedPillButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Root" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabPc"
                style="@style/SegmentedPillButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="PC" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Status Pill Separated at the End -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#27272A"
            app:cardBackgroundColor="#161618">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- Dot Indicator -->
                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/shape_status_dot_stopped" />

                <!-- Status Label -->
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Stopped"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Tab ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="84dp" />

</LinearLayout>
