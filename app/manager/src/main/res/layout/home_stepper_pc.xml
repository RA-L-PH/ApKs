<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="84dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Step 1: Install ADB -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#27272A"
            app:cardBackgroundColor="#161618"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/step1Number"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#F4F4F5"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/step_circle_bg" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Install ADB on Computer"
                        android:textColor="#F4F4F5"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="46dp"
                    android:text="Download Android Platform Tools on your computer and connect your phone with a USB cable."
                    android:textColor="#A1A1AA"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep1"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginStart="46dp"
                    android:text="Download Platform Tools"
                    android:textColor="#F4F4F5"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:backgroundTint="#27272A"
                    app:cornerRadius="25dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#3F3F46"
                    app:icon="@drawable/ic_outline_open_in_new_24"
                    app:iconTint="#A1A1AA"
                    app:iconGravity="textStart" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Step 2: Run Command -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#27272A"
            app:cardBackgroundColor="#161618"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/step2Number"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#F4F4F5"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/step_circle_bg" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Run ADB Command"
                        android:textColor="#F4F4F5"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="46dp"
                    android:text="Execute this command in your PC terminal (Command Prompt / PowerShell / Terminal):"
                    android:textColor="#A1A1AA"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.3" />

                <!-- Command Capsule Box -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="46dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#3F3F46"
                    app:cardBackgroundColor="#0D0D0E">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/adbCommand"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="adb shell sh /sdcard/Android/data/com.rc.apks/files/starter.sh"
                            android:textColor="#E4E4E7"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:textIsSelectable="true" />

                        <FrameLayout
                            android:id="@+id/btnCopy"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/shape_circle_icon_background"
                            android:backgroundTint="#27272A">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_baseline_content_copy_24"
                                android:importantForAccessibility="no"
                                android:tint="#F4F4F5" />
                        </FrameLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Troubleshooting Accordion -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#27272A"
            app:cardBackgroundColor="#161618"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/accordionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:background="?selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Troubleshooting &amp; Auto-start"
                        android:textColor="#D4D4D8"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/accordionArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more_24"
                        android:importantForAccessibility="no"
                        android:rotation="0" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/accordionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Some battery saver settings may stop background services on startup."
                        android:textColor="#A1A1AA"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBattery"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:text="Manage Battery Optimization"
                        android:textColor="#E4E4E7"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:backgroundTint="#27272A"
                        app:cornerRadius="23dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#3F3F46"
                        app:icon="@drawable/ic_outline_open_in_new_24"
                        app:iconTint="#A1A1AA"
                        app:iconSize="18dp"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
