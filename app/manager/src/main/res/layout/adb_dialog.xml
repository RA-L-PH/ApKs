<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="?colorPrimary"
        app:trackColor="#27272A"
        app:trackCornerRadius="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Looking for active Wireless Debugging connection on this device..."
        android:textColor="#E4E4E7"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.3" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="If this takes more than a few seconds, make sure Wireless Debugging is turned ON in Developer Options."
        android:textColor="#A1A1AA"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.3" />

</LinearLayout>
