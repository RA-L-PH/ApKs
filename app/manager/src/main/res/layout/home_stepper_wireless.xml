<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="84dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Server Control Button -->
        <LinearLayout
            android:id="@+id/serverButtonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/serverButtonRing"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/bg_server_button_stopped">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/serverProgressRing"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="88dp"
                    app:trackThickness="2dp"
                    app:indicatorColor="#4ADE80"
                    app:trackColor="#1B432C" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleServer"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="#40166534"
                    app:cornerRadius="41dp"
                    app:icon="@drawable/ic_server_start_24dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="34dp"
                    app:iconTint="#80FFFFFF"
                    app:strokeWidth="0dp" />

            </FrameLayout>

            <TextView
                android:id="@+id/serverLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Start Server"
                android:textColor="#9922C55E"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <!-- Step 1 Accordion: Enable Wireless Debugging -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/step1Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#27272A"
            app:cardBackgroundColor="#161618"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Step 1 Header (always visible, clickable) -->
                <LinearLayout
                    android:id="@+id/step1Header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:background="?selectableItemBackground">

                    <TextView
                        android:id="@+id/step1Number"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#F4F4F5"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/step_circle_bg" />

                    <TextView
                        android:id="@+id/step1Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Enable Wireless Debugging"
                        android:textColor="#F4F4F5"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/step1Arrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more_24"
                        android:importantForAccessibility="no"
                        android:rotation="0" />

                </LinearLayout>

                <!-- Step 1 Content (collapsible) -->
                <LinearLayout
                    android:id="@+id/step1Content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="46dp"
                        android:text="Go to Developer Options and turn on Wireless Debugging."
                        android:textColor="#A1A1AA"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStep1"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginStart="46dp"
                        android:text="Open Developer Options"
                        android:textColor="#F4F4F5"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:backgroundTint="#27272A"
                        app:cornerRadius="25dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#3F3F46"
                        app:icon="@drawable/ic_outline_open_in_new_24"
                        app:iconTint="#A1A1AA"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Step 2 Accordion: Pair Device -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/step2Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#27272A"
            app:cardBackgroundColor="#161618"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Step 2 Header (always visible, clickable) -->
                <LinearLayout
                    android:id="@+id/step2Header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:background="?selectableItemBackground">

                    <TextView
                        android:id="@+id/step2Number"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#F4F4F5"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/step_circle_bg" />

                    <TextView
                        android:id="@+id/step2Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Pair with Pairing Code"
                        android:textColor="#F4F4F5"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/step2Arrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more_24"
                        android:importantForAccessibility="no"
                        android:rotation="0" />

                </LinearLayout>

                <!-- Step 2 Content (collapsible) -->
                <LinearLayout
                    android:id="@+id/step2Content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="46dp"
                        android:text="Tap 'Pair device with pairing code' in Developer Options. A notification will appear — enter the 6-digit code there."
                        android:textColor="#A1A1AA"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStep2"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginStart="46dp"
                        android:text="Pair Device"
                        android:textColor="#F4F4F5"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:backgroundTint="#27272A"
                        app:cornerRadius="25dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#3F3F46"
                        app:icon="@drawable/ic_baseline_link_24"
                        app:iconTint="#A1A1AA"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Troubleshooting Accordion -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/troubleshootingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#27272A"
            app:cardBackgroundColor="#161618"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Accordion Header -->
                <LinearLayout
                    android:id="@+id/accordionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:background="?selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Troubleshooting &amp; Auto-start"
                        android:textColor="#D4D4D8"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/accordionArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_expand_more_24"
                        android:importantForAccessibility="no"
                        android:rotation="0" />

                </LinearLayout>

                <!-- Accordion Content (hidden by default) -->
                <LinearLayout
                    android:id="@+id/accordionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Some aggressive battery managers (MIUI, ColorOS, OneUI) may terminate background services."
                        android:textColor="#A1A1AA"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBattery"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:text="Manage Battery Optimization"
                        android:textColor="#E4E4E7"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:backgroundTint="#27272A"
                        app:cornerRadius="23dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#3F3F46"
                        app:icon="@drawable/ic_outline_open_in_new_24"
                        app:iconTint="#A1A1AA"
                        app:iconSize="18dp"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
